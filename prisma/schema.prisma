generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // ADMIN, EDITOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCategory {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  shortDesc      String
  content        String
  iconName       String?
  image          String?
  features       String?          // JSON array of strings
  categoryId     String
  category       ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  published      Boolean          @default(true)
  order          Int              @default(0)
  metaTitle      String?
  metaDesc       String?
  projects       ProjectService[]
  regionServices RegionService[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Sector {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  shortDesc     String
  content       String
  iconName      String?
  image         String?
  solutions     String?         // JSON array of strings
  published     Boolean         @default(true)
  order         Int             @default(0)
  metaTitle     String?
  metaDesc      String?
  projects      ProjectSector[]
  regionSectors RegionSector[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Project {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  client       String?
  location     String?
  year         Int?
  categoryType String           // ELEKTRIK, OTOMASYON, ENERJI, GES, KAMU, ENDUSTRIYEL
  scope        String?          // Proje kapsamı
  workDone     String?          // JSON string
  technologies String?          // JSON string
  capacity     String?          // Kurulu güç / kapasite
  coverImage   String?
  documentUrl  String?
  status       String           @default("COMPLETED") // COMPLETED, ONGOING
  featured     Boolean          @default(false)
  published    Boolean          @default(true)
  metaTitle    String?
  metaDesc     String?
  images       ProjectImage[]
  services     ProjectService[]
  sectors      ProjectSector[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ProjectService {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
}

model ProjectSector {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectorId  String
  sector    Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([projectId, sectorId])
}

model Reference {
  id        String   @id @default(cuid())
  company   String
  logoUrl   String?
  industry  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certificate {
  id          String   @id @default(cuid())
  title       String
  code        String?  // ISO 9001, ISO 14001 vb.
  issuer      String?
  issueYear   Int?
  fileUrl     String?
  imageUrl    String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  content     String
  coverImage  String?
  category    String   @default("Teknik")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  metaTitle   String?
  metaDesc    String?
  // Multilingual fields
  titleEn     String?
  titleAr     String?
  titleRu     String?
  summaryEn   String?
  summaryAr   String?
  summaryRu   String?
  contentEn   String?
  contentAr   String?
  contentRu   String?
  metaTitleEn String?
  metaTitleAr String?
  metaTitleRu String?
  metaDescEn  String?
  metaDescAr  String?
  metaDescRu  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Career {
  id           String           @id @default(cuid())
  title        String
  department   String
  location     String
  workType     String           // Tam Zamanlı, Hibrit, Proje Bazlı
  description  String
  requirements String           // JSON or formatted text
  deadline     DateTime?
  active       Boolean          @default(true)
  applications JobApplication[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model JobApplication {
  id          String   @id @default(cuid())
  careerId    String
  career      Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  fullName    String
  email       String
  phone       String
  cvUrl       String
  coverLetter String?
  status      String   @default("NEW") // NEW, REVIEWED, CONTACTED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuoteRequest {
  id              String      @id @default(cuid())
  referenceNo     String      @unique // SP-2026-XXXX
  companyName     String
  contactPerson   String
  phone           String
  email           String
  city            String
  projectLocation String?
  serviceType     String
  description     String
  plannedDate     String?
  status          String      @default("NEW") // NEW, IN_REVIEW, PREPARING, SENT, WON, LOST
  adminNotes      String?
  landingPage     String?     // Lead tracking
  referrer        String?     // Lead tracking
  utmSource       String?     // Lead tracking
  utmMedium       String?     // Lead tracking
  utmCampaign     String?     // Lead tracking
  files           QuoteFile[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model QuoteFile {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  createdAt      DateTime     @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id             String   @id @default("default")
  companyName    String   @default("Soykan Power Mühendislik")
  phone          String?
  email          String?
  address        String?
  workingHours   String?
  mapEmbedUrl    String?
  linkedinUrl    String?
  instagramUrl   String?
  twitterUrl     String?
  facebookUrl    String?
  footerText     String?
  aboutSummary   String?
  updatedAt      DateTime @updatedAt
}

model SeoPage {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String
  description String
  keywords    String?
  ogImage     String?
  updatedAt   DateTime @updatedAt
}

model Redirect {
  id          String   @id @default(cuid())
  sourcePath  String   @unique
  targetPath  String
  statusCode  Int      @default(301)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Country {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isoCode   String   @unique
  active    Boolean  @default(true)
  regions   Region[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Region {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  countryId        String?
  country          Country?             @relation(fields: [countryId], references: [id], onDelete: SetNull)
  regionType       String               @default("CITY") // CITY, PROVINCE, SPECIAL
  shortDescription String?
  description      String?
  heroTitle        String?
  heroDescription  String?
  heroImage        String?
  isServiceArea    Boolean              @default(true)
  isFeatured       Boolean              @default(false)
  isPublished      Boolean              @default(true)
  indexable        Boolean              @default(true)
  sortOrder        Int                  @default(0)
  status           String               @default("PUBLISHED") // DRAFT, READY, PUBLISHED, NOINDEX, ARCHIVED
  metaTitle        String?
  metaDesc         String?
  districts        District[]
  regionServices   RegionService[]
  regionSectors    RegionSector[]
  regionFaqs       RegionFaq[]
  contentBlocks    RegionContentBlock[]
  landingPages     SeoLandingPage[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model District {
  id          String   @id @default(cuid())
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  isPublished Boolean  @default(false)
  indexable   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([regionId, slug])
}

model RegionService {
  id                String   @id @default(cuid())
  regionId          String
  region            Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  serviceId         String
  service           Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  customTitle       String?
  customDescription String?
  customContent     String?
  heroImage         String?
  indexable         Boolean  @default(true)
  published         Boolean  @default(true)
  sortOrder         Int      @default(0)
  metaTitle         String?
  metaDesc          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([regionId, serviceId])
}

model RegionSector {
  id                String   @id @default(cuid())
  regionId          String
  region            Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  sectorId          String
  sector            Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  customTitle       String?
  customDescription String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([regionId, sectorId])
}

model RegionFaq {
  id        String   @id @default(cuid())
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  serviceId String?
  sectorId  String?
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegionContentBlock {
  id        String   @id @default(cuid())
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  serviceId String?
  blockType String   // HERO, INTRO, SERVICES, SECTORS, PROJECTS, PROCESS, ADVANTAGES, FAQ, CTA, FORM
  title     String?
  subtitle  String?
  content   String?
  mediaUrl  String?
  settings  String?  // JSON string for configuration
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoLandingPage {
  id              String   @id @default(cuid())
  pageName        String
  pageType        String   @default("CITY") // CITY, CITY_SERVICE, CITY_SECTOR, SERVICE, SECTOR, CUSTOM
  regionId        String?
  region          Region?  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  serviceId       String?
  sectorId        String?
  slug            String   @unique
  h1              String?
  heroTitle       String?
  heroDescription String?
  introContent    String?
  mainContent     String?
  ctaTitle        String?
  ctaDescription  String?
  seoTitle        String?
  metaDescription String?
  canonical       String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  indexable       Boolean  @default(true)
  followable      Boolean  @default(true)
  status          String   @default("PUBLISHED") // DRAFT, READY, PUBLISHED, NOINDEX, ARCHIVED
  schemaType      String   @default("Service") // Organization, Service, LocalBusiness, FAQPage
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TechnicalGuide {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  summary            String
  content            String
  category           String   // OG & Trafo, Otomasyon & SCADA, Pano & Enerji, GES, Standartlar & Mevzuat
  readTime           String?  // "6 dk okuma"
  coverImage         String?
  relatedServiceSlug String?
  relatedSectorSlug  String?
  relatedRegionSlug  String?
  faqItems           String?  // JSON array of { question, answer }
  published          Boolean  @default(true)
  order              Int      @default(0)
  metaTitle          String?
  metaDesc           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SeoTemplate {
  id           String   @id @default(cuid())
  templateType String   @unique // CITY, CITY_SERVICE, CITY_SECTOR, SERVICE, SECTOR, BLOG, PROJECT
  titlePattern String
  descPattern  String
  h1Pattern    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


